# Secrets. Fill these in. Never commit the real .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Postgres. The _RO user can only SELECT; the agent's sql_query uses it.
DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot
DATABASE_URL_RO=postgresql://opspilot_ro:readonly@localhost:5432/opspilot

# Models. Everything below is optional; these are the defaults.
MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5.6-luna

# Limits. The run stops at whichever is hit first.
MAX_STEPS=10
MAX_COST_USD=0.25
MAX_TOKENS=1024

# Behaviour.
PARALLEL=true
REQUIRE_APPROVAL=true
USE_MCP=false
LOG_PREVIEW_CHARS=200
